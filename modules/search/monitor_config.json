    },
    {
      "name": "DeFi News",
      "query": "defi protocol launch -is:retweet lang:en",
      "sort": "top",
      "priority": "medium",
      "min_likes": 10
    },
    {
      "name": "NFT Drops",
      "query": "NFT mint live -is:retweet lang:en",
      "sort": "latest",
      "priority": "low",
      "min_likes": 3
    }
  ]

{
  "settings": {
    "cycle_interval_minutes": 10,
    "queries_per_cycle": 3,
    "pages_per_query": 1,
    "results_per_query": 20,
    "pause_between_queries_sec": 15,
    "save_reports": true,
    "seen_tweets_file": "modules/search/seen_tweets.json",
    "max_seen_tweets": 50000,
    "report_dir": "modules/search/reports"

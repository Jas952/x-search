# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30

# ── Search cycle ─────────────────────────────────────────────────────────────
SEARCH_CYCLE_MINUTES=10

# ── Twitter cookies & headers: UserByScreenName (get user ID) ────────────────
# Copy from DevTools → Network → UserByScreenName request
TWITTER_COOKIES_CONFIG={"auth_token":"","ct0":"","guest_id":""}
HEADERS_ID_CONFIG={"authorization":"Bearer AAAAAAAAAAAAAAAAAAAAAA...","x-csrf-token":"","x-twitter-active-user":"yes","x-twitter-auth-type":"OAuth2Session"}
PARAMS_ID_CONFIG={"features":"{}","fieldToggles":"{}"}

# ── Twitter cookies & headers: Following (get followings list) ────────────────
COOKIES_FOLLOWING_CONFIG={"auth_token":"","ct0":"","guest_id":""}
HEADERS_FOLLOWING_CONFIG={"authorization":"Bearer AAAAAAAAAAAAAAAAAAAAAA...","x-csrf-token":""}
PARAMS_FOLLOWING_CONFIG={"features":"{}","fieldToggles":"{}"}

# ── Twitter cookies & headers: SearchTimeline ────────────────────────────────
COOKIES_SEARCH_CONFIG={"auth_token":"","ct0":"","guest_id":""}
HEADERS_SEARCH_CONFIG={"authorization":"Bearer AAAAAAAAAAAAAAAAAAAAAA...","x-csrf-token":""}

# ── Twitter cookies & headers: BigFollow, Reply, Info (optional modules) ─────
COOKIES_BIG_CONFIG=
HEADERS_BIG_CONFIG=
PARAMS_BIG_CONFIG=

COOKIES_REPLY_CONFIG=
HEADERS_REPLY_CONFIG=
PARAMS_REPLY_CONFIG=

COOKIES_INFO_CONFIG=
HEADERS_INFO_CONFIG=
PARAMS_INFO_CONFIG=
